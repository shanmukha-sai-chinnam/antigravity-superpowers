{
  "mcpServers": {
    "nix-search": {
      "command": "nix",
      "args": [
        "run",
        "nixpkgs#nix-search-cli",
        "--",
        "--server"
      ],
      "env": {
        "NIXPKGS_ALLOW_UNFREE": "1"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git"
      ]
    }
  }
}
